# Copy to .env and adjust. Every value below has a default in app/config/settings.py
# except LLM_MODEL, which is required for answer generation.

# --- LLM -------------------------------------------------------------------------
# "ollama" (local) or "openai_compatible" (any server exposing /v1/chat/completions,
# e.g. vLLM, LM Studio, llama.cpp server, OpenAI).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
# Ollama num_ctx; its small default would silently truncate long RAG prompts.
LLM_CONTEXT_WINDOW=8192
LLM_TIMEOUT_SECONDS=300
# Reasoning models (e.g. qwen3) think before answering by default; on CPU that is slow.
# Set false to disable thinking. Leave unset for models without reasoning support.
# LLM_THINK=false

# Only used when LLM_PROVIDER=openai_compatible. Never commit a real key.
# OPENAI_BASE_URL=http://localhost:8001/v1
# OPENAI_API_KEY=

# --- Embedding / reranking ---------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Asymmetric retrieval prefix for queries only (BGE's default shown; E5 would use "query: ").
EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_BATCH_SIZE=32
# DEVICE=cpu   # cpu | cuda | mps ; unset = auto-detect

# --- Chunking (tokens of the embedding model's tokenizer) ----------------------
# Both BGE models have a 512-token window, so chunks above ~480 tokens get truncated.
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# --- Retrieval -----------------------------------------------------------------
TOP_K_DENSE=10
TOP_K_BM25=10
TOP_K_HYBRID=20
TOP_K_RERANKED=5
# hybrid_score = alpha * dense_norm + (1 - alpha) * bm25_norm
HYBRID_ALPHA=0.6

# --- Context filtering ---------------------------------------------------------
MIN_RERANK_SCORE=0.05
MAX_CONTEXT_TOKENS=2000

# --- Storage -------------------------------------------------------------------
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CHROMA_COLLECTION=ragforge

# --- Services ------------------------------------------------------------------
# Where the Streamlit UI reaches the FastAPI backend.
API_URL=http://localhost:8000

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
